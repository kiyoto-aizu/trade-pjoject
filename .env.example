# LINE Message API
LINE_MESSAGE_CHANNEL_TOKEN=
LINE_MESSAGE_TO=

# kabusapi settings
API_PORT_DEV=
API_PASSWORD_DEV=
API_PORT_PRD=
API_PASSWORD_PRD=

# 実行モード（true: デモ環境 / false: 本番環境）
IS_DEMO=true
# 本番モード(IS_DEMO=false)で実取引を許可する場合のみtrue
ENABLE_LIVE_ORDERING=false

# キルスイッチ・資金管理設定
# スクリーニング対象とする1株あたりの株価上限（円）
MAX_SHARE_PRICE=1000
# 取引に利用可能な運用資本（円）
OPERATING_CAPITAL=1000000
# 1回の取引あたりの最大注文金額（円）
MAX_ORDER_AMOUNT_PER_TRADE=100000
# 1日あたりの最大注文数
MAX_ORDER_COUNT_PER_DAY=10
# 1日の損失限度額（運用資本の比率、例：0.02 = 2%）
DAILY_LOSS_LIMIT_RATIO=0.02
# APIソフトリミット（kabu APIの現物ワンショット上限、円）
API_SOFT_LIMIT=1000000
# kabuステーションAPIの最小呼出間隔（秒）
API_REQUEST_INTERVAL_SECONDS=0.12
