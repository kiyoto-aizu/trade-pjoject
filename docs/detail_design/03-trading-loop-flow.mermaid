flowchart TD
    Start(["cron: 当日9:35頃起動<br/>run_trading.py"]) --> A1["API接続 & トークン取得"]
    A1 --> A2["FilteringResultRepository.load_for_date()<br/>当日の候補を最大10銘柄読み込み"]
    A2 --> A3{"当日結果・銘柄あり?"}
    A3 -->|No| A3a(["起動中止 + 通知<br/>ループ開始しない"])
    A3 -->|Yes| A4["最大10候補の確定終値・板情報を事前取得"]
    A4 --> A4chk{"全銘柄のデータ取得成功?"}
    A4chk -->|No| A3a
    A4chk -->|Yes| Allocate["資金配分で発注対象を最大3銘柄に決定"]

    Allocate --> Loop["メイン監視ループ開始<br/>(配分後の銘柄を1日固定)"]

    subgraph LOOP["監視ループ（各銘柄ごと）"]
        direction TB
        S3["確定終値からSMA5・RSI14を計算"]
        S3 --> S4["③ GET /board/symbol<br/>現在値取得"]
        S4 --> S4chk{"取得不可?"}
        S4chk -->|Yes| Skip["当該銘柄のみ評価スキップ"]
        S4chk -->|No| S5

        S5["④ domain/rules.py<br/>売買条件判定<br/>→ Signal(BUY/SELL/NONE)"]
        S5 --> S5chk{"Signalあり?"}
        S5chk -->|NONE| Skip

        S5chk -->|BUY/SELL| S6a["⑤ GET /wallet/cash・/positions・/apisoftlimit 再取得"]
        S6a --> S6b["⑤ 発注セーフティチェック<br/>予算/重複注文/保有有無<br/>+ キルスイッチ判定"]
        S6b --> S6chk{"チェックOK?"}
        S6chk -->|NG| Skip

        S6chk -->|OK| S7["⑥ POST /sendorder<br/>発注実行"]
        S7 --> S6log["注文履歴へ永続化<br/>監査ログ記録"]
        S6log --> Skip
    end

    Loop --> LOOP
    Skip --> AllDone{"全銘柄処理済み?"}
    AllDone -->|No| LOOP
    AllDone -->|Yes| S8["⑦ 60秒スリープ"]

    S8 --> S9["⑧ 次のループ開始時にis_market_closed()"]
    S9 --> S9chk{"取引時間内?"}
    S9chk -->|Yes| Loop
    S9chk -->|No| S10

    S10["⑨ 日次レポートをJSON保存・通知<br/>発注件数・評価損益・キルスイッチ<br/>LLM分析は有効時のみ参考情報として追加"]
    S10 --> End(["終了"])

    style A3a fill:#f8d7da,stroke:#c0392b
    style Skip fill:#fff3cd,stroke:#d4a017
