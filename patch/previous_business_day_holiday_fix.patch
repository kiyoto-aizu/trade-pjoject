+    # 2026-09-21(月・敬老の日)〜09-23(水・秋分の日)は祝日、直前の営業日は09-18(金)
+    target_date = datetime(2026, 9, 24).date()
+    screening_repository = ScreeningResultRepository(tmp_path / "screening")
